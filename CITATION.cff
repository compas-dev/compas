cff-version: 1.2.0
message: "If you use COMPAS in your research, please cite it as below."
title: "COMPAS"
type: software
abstract: >-
  COMPAS is an open-source, Python-based framework for computational research
  and collaboration in Architecture, Engineering, Fabrication and Construction.
# Concept DOI: always resolves to the latest release on Zenodo.
doi: 10.5281/zenodo.2594510
identifiers:
  - type: doi
    value: 10.5281/zenodo.2594510
    description: Concept DOI for all versions of COMPAS.
repository-code: "https://github.com/compas-dev/compas"
url: "https://compas.dev"
license: MIT
keywords:
  - architecture
  - engineering
  - fabrication
  - construction
  - computational design
  - python
